# Template for android/keystore.properties -- copy to that name and fill in.
# The real file is git-ignored (see android/.gitignore); never commit signing
# credentials. Alternatively export ENLIGHTENED_KEYSTORE,
# ENLIGHTENED_KEYSTORE_PASSWORD, ENLIGHTENED_KEYSTORE_ALIAS and
# ENLIGHTENED_KEYSTORE_KEY_PASSWORD instead of using this file.
#
# Create a keystore with:
#   keytool -genkeypair -v -keystore android/enlightened-release.jks \
#     -alias enlightened -keyalg RSA -keysize 4096 -validity 10950
#
# Back up the .jks and its passwords: without them you cannot build an update
# that installs over an already-installed copy of the app.

# Path to the keystore, absolute or relative to the android/ directory.
storeFile=enlightened-release.jks
storePassword=CHANGEME
keyAlias=enlightened
keyPassword=CHANGEME
