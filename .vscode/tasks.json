{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "npm: start",
            "type": "npm",
            "script": "start",
            "isBackground": true,
            "problemMatcher": {
                "owner": "typescript",
                "pattern": "$tsc",
                "background": {
                    "activeOnStart": true,
                    "beginsPattern": "Starting|Compiling",
                    "endsPattern": "Compiled successfully|compiled successfully"
                }
            }
        },
        {
            "label": "npm run build && npx cap sync",
            "type": "shell",
            "command": "npm run build && npx cap sync",
            "group": {
                "kind": "build",
                "isDefault": true 
            }
        }
    ]
}
